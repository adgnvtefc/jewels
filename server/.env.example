# Copy to server/.env (never commit it).
# Accounts and their passwords live in the database, set with accounts.py (see its docstring).
# Optional:
# PORT=8787
# ALLOWED_ORIGINS=https://momoswebsiteofthehour.com,http://localhost:4173,http://127.0.0.1:4173
# USE_AGENT=1                       # 0 skips the harness and uses the idea as written
# USE_MODEL=1                       # 0 runs without the picture model (for testing accounts and chat)
# HARNESS_ENV=../../harness/.env    # where the harness's OMLX_API_KEY lives
# MODEL_PATH=filipstrand/Z-Image-Turbo-mflux-4bit
# DB_FILE=data/jewels.db            # the database; use a throwaway file when testing

# Token for textbot's notify service (~/projects/textbot/notify.py), which texts players
# about unread chat messages. Copy NOTIFY_TOKEN_JEWELS from textbot's .env. Empty: no texts.
TEXTBOT_NOTIFY_TOKEN=
